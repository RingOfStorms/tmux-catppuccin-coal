--- a/flakes/common/hm_modules/tmux/default.nix
+++ b/flakes/common/hm_modules/tmux/default.nix
@@ -57,33 +57,38 @@
       # One detached namer per server (it exits with the server); -b + setsid
       # keep tmux startup from ever waiting on it.
       run-shell -b 'command -v tmux-ai-names >/dev/null && { setsid tmux-ai-names </dev/null >/dev/null 2>&1 & }; true'
+
+      # Status line composition. v2.3.2 no longer builds status-left/right
+      # from @catppuccin_status_modules_*, so compose it explicitly here.
+      # This block is emitted after plugin run-shells, so the module
+      # variables exist by the time it runs.
+      set -g status-left-length 100
+      set -g status-right-length 100
+      set -g status-left "#{E:@catppuccin_status_session}"
+      set -g status-right "#{E:@catppuccin_status_directory}#{E:@catppuccin_status_application}#{E:@catppuccin_status_date_time}"
     '';
 
